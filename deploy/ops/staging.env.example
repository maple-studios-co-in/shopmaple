# ShopMaple STAGING environment: /home/deploy/shopmaple-staging/shared/staging.env (0600).
# staging-setup.sh creates it from this template, fills the @...@ values it can generate, and appends the read-only
# Keeri catalogue settings from store.env. Check it with: node /home/deploy/shopmaple/ops/tools/ops/staging-env-check.mjs
# Never copy production payment, mail or Keeri commerce secrets here (the check refuses them).
DATABASE_URL=postgresql://shopmaple_staging:@DB_PASSWORD@@127.0.0.1:55441/shopmaple_staging
API_PORT=4120
API_HOST=127.0.0.1
API_URL=http://127.0.0.1:4120
WEB_ORIGIN=https://staging.maplefurnishers.com
SITE_URL=https://staging.maplefurnishers.com
CATALOG_MODE=preview
NODE_ENV=production
API_TRUST_PROXY_LOOPBACK=true
# Search engines: staging must never be indexed (every response says noindex unless this is on).
SEO_INDEXING=off
SHOP_MEDIA_ROOT=/home/deploy/shopmaple-staging/shared/media
ADMIN_PREVIEW_SECRET=@PREVIEW_SECRET@
# Website enquiries stay in staging's admin: no Keeri leads, no staff email.
KEERI_LEADS_ENABLED=false
ENQUIRY_DELIVERY_ENABLED=false
CUSTOMER_ACCOUNTS_ENABLED=false
# Online checkout is OFF on staging until the owner decides (docs/operations-staging.md, "Checkout on staging").
# Turning it on needs ALL of: Razorpay TEST keys (rzp_test_...), a separate Keeri merchant scope and commerce
# credential for staging (otherwise test orders reserve live stock in Keeri), and order mail going to ONE test inbox:
# CHECKOUT_ENABLED=true
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# KEERI_COMMERCE_TOKEN=...
# KEERI_MERCHANT_SCOPE=...
# CHECKOUT_DELIVERY_METHODS=[{"id":"...","label":"..."}]
# ORDER_RESEND_API_KEY=...
# ORDER_MAIL_FROM=no-reply@maplefurnishers.com
# ORDER_MAIL_TO=one-test-inbox@example.com
CHECKOUT_ENABLED=false
# Read-only Keeri catalogue settings (product photos are served through them) are appended below by staging-setup.sh.
