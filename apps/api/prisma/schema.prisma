generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Product {
  id String @id
  handle String @unique
  title String
  description String
  pdpContent Json?
  category String?
  images String[]
  published Boolean @default(false)
  source String
  sourceTaxonomy Json?
  sourceDetails Json?
  /// Keeri's product-page data: specs, highlights, FAQ, reviews, photo details and bundles.
  productPage Json?
  /// Keeri's approved reviews, kept from productPage at each sync so cards carry a rating without reading the page:
  /// how many there are (0 when none) and their average to one decimal (null when none).
  reviewCount Int @default(0)
  reviewAverage Float?
  /// The product's own Keeri offer for the product page's countdown ({ label, code, startsAt, endsAt }); null without one.
  offer Json?
  sourceStatus String?
  sourceUpdatedAt DateTime
  variants Variant[]
  identities ProductSourceIdentity[]
  handleAliases ProductHandleAlias[]
  updatedAt DateTime @updatedAt
}
model Variant {
  id String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title String
  sku String?
  pricePaise Int?
  compareAtPaise Int?
  published Boolean @default(true)
  available Boolean @default(false)
  stockPolicy String @default("unverified")
  /// Keeri's approved making time for a made-to-order variant; null otherwise.
  leadTimeDays Int?
  /// Keeri staff ticked this variant free delivery (Keeri's `freeDelivery=1` catalogue level). Shown as a badge only;
  /// the quote decides the charge.
  freeDelivery Boolean @default(false)
  /// This variant's own photos; Product.images keeps every photo for cards.
  images String[] @default([])
  /// The readable ?variant= value, unique within its product.
  slug String?
  /// Keeri's product-page data for this variant: measurements, copy, batch count and options.
  productPage Json?
  cartItems CartItem[]
  identities VariantSourceIdentity[]
}

/// A product's earlier address, kept so old links redirect permanently to the current one.
model ProductHandleAlias {
  handle String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([productId])
}
model ProductSourceIdentity {
  source String
  externalId String
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([source, externalId])
  @@unique([source, productId])
}

model VariantSourceIdentity {
  source String
  externalId String
  variantId String
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@id([source, externalId])
  @@unique([source, variantId])
}
model Cart {
  id String @id @default(cuid())
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items CartItem[]
  revision Int @default(0)
  mutations CartMutationReceipt[]
}
model CartMutationReceipt {
  cartId String
  operationId String
  payloadHash String
  status Int
  code String
  message String
  createdAt DateTime @default(now())
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  @@id([cartId, operationId])
}
model CartItem {
  cartId String
  variantId String
  quantity Int
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@id([cartId, variantId])
}

// One durable cursor per tenant source, including completely empty snapshots.
model CatalogueSyncState {
  source String @id
  capturedAt DateTime
  payloadHash String
  importedAt DateTime @default(now())
}

model Enquiry {
  id String @id
  idempotencyHash String @unique
  payloadHash String
  kind String
  name String
  email String
  phone String
  message String
  context Json
  status String @default("new")
  lostReason String?
  version Int @default(0)
  /// One outbox row per target: the staff email and, when enabled, the Keeri lead.
  deliveries EnquiryDelivery[]
  reviews EnquiryReviewAudit[]
  assignedToId String?
  assignedTo ShopAdmin? @relation("AssignedEnquiries", fields: [assignedToId], references: [id], onDelete: Restrict)
  contactId String?
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  activity EnquiryActivity[]
  tasks FollowUpTask[]
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([assignedToId, createdAt, id])
  @@index([contactId, createdAt])
}

// One CRM contact per customer, keyed by normalised email and phone. Created by enquiries and the backfill migration.
model Contact {
  id String @id
  emailKey String @unique
  phoneKey String?
  name String
  email String
  phone String
  city String @default("")
  tags String[] @default([])
  notes String @default("")
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  enquiries Enquiry[]
  tasks FollowUpTask[]
  activity ContactActivity[]
  @@index([createdAt, id])
  @@index([phoneKey])
}

model ContactActivity {
  id String @id @default(cuid())
  contactId String
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  actorId String
  actor ShopAdmin @relation("ContactActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  version Int
  action String
  taskId String?
  body String?
  createdAt DateTime @default(now())
  @@unique([contactId, version])
}

model FollowUpTask {
  id String @id @default(cuid())
  enquiryId String?
  enquiry Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  contactId String?
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  title String
  dueOn DateTime @db.Date
  assigneeId String?
  assignee ShopAdmin? @relation("FollowUpTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  note String @default("")
  done Boolean @default(false)
  completedAt DateTime?
  createdById String
  createdBy ShopAdmin @relation("FollowUpTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([done, dueOn, id])
  @@index([assigneeId, done, dueOn])
  @@index([enquiryId, done, dueOn])
  @@index([contactId, done, dueOn])
}

model CheckoutAttempt {
  id String @id
  cartId String
  merchantScope String
  idempotencyKey String
  receipt String @unique
  snapshot Json
  catalogueBindings Json?
  amountPaise Int
  currency String @default("INR")
  state String @default("reservation_required")
  reservationId String? @unique
  reservationExpiresAt DateTime?
  providerOrderId String? @unique
  paymentId String? @unique
  capturedAt DateTime?
  failureCode String?
  /// The customer's email from the quote snapshot, lowercased and trimmed (Customer.emailKey's form). Set when the quote
  /// freezes the attempt; customer accounts list paid attempts by it. Null for legacy (version 1) snapshots.
  customerEmailKey String?
  /// Maple's order number (shown as "MF-<n>"), from the maple_order_number_seq sequence (START 10001). Assigned once,
  /// inside the transaction that records the captured payment, and never reused.
  orderNumber Int? @unique
  /// When the buyer ticked "Send my order updates on WhatsApp" at checkout and asked for this quote: their consent to
  /// WhatsApp messages about this order. Null: no consent, and Keeri is never told to message them.
  whatsappOptInAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cartId, idempotencyKey])
  @@index([customerEmailKey])
}

/// A shopper who signs in with an emailed one-time code (customer accounts, 10 Nov 2026). Created by the first
/// successful sign-in. Orders are linked by email, not by id: a paid CheckoutAttempt whose customerEmailKey equals
/// emailKey is this customer's.
model Customer {
  id String @id @default(uuid())
  /// Lowercased and trimmed: the same key as the checkout snapshot's email (CheckoutAttempt.customerEmailKey).
  emailKey String @unique
  name String?
  /// +91 and ten digits, as the checkout snapshot normalises it.
  phone String?
  /// scrypt (see account/security.ts), set only after an emailed code proved the address; null: sign in by code only.
  passwordHash String?
  passwordSetAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions CustomerSession[]
  addresses CustomerAddress[]
}

/// One emailed sign-in code. Only an HMAC-SHA256 of the code is kept (keyed by ACCOUNT_CODE_SECRET), and of the
/// requesting network (an IPv4 address or IPv6 /64). Rows are counted for the sign-in limits and pruned after two days.
model CustomerLoginChallenge {
  id String @id @default(uuid())
  emailKey String
  codeHash String
  ipHash String
  /// SHA-256 of the sign-in cookie of the browser that asked: only that browser can try this code.
  nonceHash String
  expiresAt DateTime
  attempts Int @default(0)
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([emailKey, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}

/// One failed sign-in try, for the failed-try budgets: 20 an hour per network (every failure), and 10 a day per email
/// (`wrongCode`: wrong digits for a live code of the browser's own). Pruned after two days.
model CustomerSignInFailure {
  id String @id @default(uuid())
  emailKey String
  ipHash String
  wrongCode Boolean
  createdAt DateTime @default(now())
  @@index([ipHash, createdAt])
  @@index([emailKey, createdAt])
  @@index([createdAt])
}

/// A signed-in browser. The cookie carries 32 random bytes; only their SHA-256 is stored.
model CustomerSession {
  id String @id @default(uuid())
  tokenHash String @unique
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  @@index([customerId])
  @@index([expiresAt])
}

/// A saved delivery address: at most ten per customer, and exactly one default whenever any exist (kept by the account
/// service under a lock on the customer row).
model CustomerAddress {
  id String @id @default(uuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// What the customer calls the place ("Home", "Studio"); null when they gave none.
  label String?
  name String
  line1 String
  line2 String?
  city String
  /// The GST state code checkoutAddressSchema uses (e.g. "27").
  state String
  pin String
  phone String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId, updatedAt])
}

model PaymentWebhookInbox {
  id String @id @default(cuid())
  merchantScope String
  eventId String
  bodySha256 String
  eventType String
  providerOrderId String?
  paymentId String?
  state String @default("pending")
  failureCode String?
  receivedAt DateTime @default(now())
  processedAt DateTime?
  workerState String @default("pending")
  deliveryAttempts Int @default(0)
  nextAttemptAt DateTime @default(dbgenerated("timezone('UTC'::text, now())"))
  leaseToken String?
  leaseExpiresAt DateTime?
  workerFailureCode String?
  @@unique([merchantScope, eventId])
  @@unique([merchantScope, bodySha256])
  @@index([state, receivedAt])
  @@index([merchantScope, workerState, nextAttemptAt])
  @@index([merchantScope, eventType, receivedAt])
  @@index([merchantScope, providerOrderId])
}

/// What Keeri reported about a store order after accepting it: status moves, delivery, cancellation and refund
/// (orders/keeri-events.ts). Kept as received, one row per signed body, and read by the order pages. `externalOrderId` is
/// the id Keeri returned when it accepted the order (`OrderOutbox.externalOrderId`); there is no foreign key, because an
/// event may arrive before the store has recorded that acceptance.
model KeeriOrderEvent {
  id String @id @default(cuid())
  merchantScope String
  externalOrderId String
  type String
  bodySha256 String
  payload Json
  occurredAt DateTime
  receivedAt DateTime @default(now())
  @@unique([merchantScope, bodySha256])
  @@index([merchantScope, externalOrderId, occurredAt])
}
model OrderOutbox {
  id String @id @default(cuid())
  attemptId String
  kind String
  payload Json
  state String @default("pending")
  deliveryAttempts Int @default(0)
  nextAttemptAt DateTime @default(dbgenerated("timezone('UTC'::text, now())"))
  leaseToken String?
  leaseExpiresAt DateTime?
  failureCode String?
  deliveredAt DateTime?
  externalOrderId String?
  createdAt DateTime @default(now())
  @@unique([attemptId, kind])
  @@index([state, createdAt])
  @@index([state, nextAttemptAt])
}

/// One email per checkout attempt (or unmatched payment) and purpose. The body is rendered
/// at send time from the attempt, so no customer details are copied here.
model OrderNotification {
  id String @id @default(cuid())
  merchantScope String
  /// A CheckoutAttempt id, or `inbox:<PaymentWebhookInbox id>` for a payment matching no attempt.
  subjectId String
  kind String
  state String @default("pending")
  deliveryAttempts Int @default(0)
  nextAttemptAt DateTime @default(dbgenerated("timezone('UTC'::text, now())"))
  leaseToken String?
  leaseExpiresAt DateTime?
  providerId String?
  failureCode String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@unique([merchantScope, subjectId, kind])
  @@index([state, nextAttemptAt])
}

// Shop presentation authority is separate from Keeri commerce data.
enum ShopAdminRole {
  editor
  publisher
  /// Opens the admin and previews drafts; cannot save, upload or publish.
  viewer
  /// No content at all: somebody whose only access is the Enquiries screen.
  none
}
model ShopAdmin {
  id String @id @default(cuid())
  email String @unique
  /// Null for somebody who only ever signs in with their Keeri account.
  passwordHash String?
  /// The Keeri user this person is, once they have signed in with Keeri. Their name, email, role and
  /// enquiry access are then Keeri's, copied here at sign-in and at each re-check so History can name them.
  keeriUserId String? @unique
  name String?
  role ShopAdminRole
  active Boolean @default(true)
  canManageEnquiries Boolean @default(false)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())
  sessions ShopAdminSession[]
  signIns ShopAdminSignIn[]
  passwordResets ShopAdminPasswordReset[]
  revisions ShopContentRevision[]
  mediaAssets ShopMediaAsset[]
  deliveryRetries EnquiryDeliveryRetryAudit[]
  enquiryReviews EnquiryReviewAudit[]
  assignedEnquiries Enquiry[] @relation("AssignedEnquiries")
  enquiryActivity EnquiryActivity[] @relation("EnquiryActivityActor")
  enquiryAssignments EnquiryActivity[] @relation("EnquiryActivityAssignee")
  contactActivity ContactActivity[] @relation("ContactActivityActor")
  followUpTasks FollowUpTask[] @relation("FollowUpTaskAssignee")
  createdFollowUpTasks FollowUpTask[] @relation("FollowUpTaskCreator")
}
model ShopAdminSession {
  id String @id @default(cuid())
  tokenHash String @unique
  adminId String
  admin ShopAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// How this session began: password (as before Keeri sign-in), keeri, or emergency (the one
  /// password account kept for when Keeri cannot be reached).
  method String @default("password")
  /// When Keeri last confirmed this person still has access; set only on a Keeri session.
  keeriCheckedAt DateTime?
  @@index([expiresAt])
}
/// A one-time emailed link to choose a new password for the emergency account. Only the link's hash is kept.
/// Rows stay as the record of each request and whether it was used.
model ShopAdminPasswordReset {
  id String @id @default(cuid())
  adminId String
  admin ShopAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([adminId, createdAt])
}
/// One row per sign-in while Keeri sign-in is on: who, when and which way (keeri, emergency, or
/// emergency_failed for a refused try at the emergency account). Never a password, code or token.
/// The record outlives the staff row: removing a person leaves when and how somebody signed in.
model ShopAdminSignIn {
  id String @id @default(cuid())
  adminId String?
  admin ShopAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  method String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([adminId, createdAt])
}
model ShopContent {
  id String @id
  version Int @default(0)
  draft Json
  published Json?
  publishedVersion Int?
  updatedAt DateTime @updatedAt
  revisions ShopContentRevision[]
}
model ShopContentRevision {
  id String @id @default(cuid())
  documentId String
  document ShopContent @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version Int
  action String
  content Json
  actorId String
  actor ShopAdmin @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([documentId, version])
}

/// A media library file: a WebP image the API made from an upload, or a film (MP4 or WebM) stored as uploaded.
enum ShopMediaKind {
  image
  video
}

model ShopMediaAsset {
  id String @id @default(cuid())
  sha256 String @unique
  storageKey String @unique
  kind ShopMediaKind @default(image)
  label String
  /// Always set for images; a film's frame size when its file states one.
  width Int?
  height Int?
  bytes Int
  mimeType String
  /// A film's running time, when its file states one.
  durationMs Int?
  /// An MP4 whose index comes before its pictures, so it starts playing before it has downloaded; null for images and WebM.
  faststart Boolean?
  createdById String
  createdBy ShopAdmin @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  publicAt DateTime?
  @@index([createdAt, id])
}
model EnquiryReviewAudit {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  actorId String
  actor ShopAdmin @relation(fields: [actorId], references: [id], onDelete: Restrict)
  version Int
  action String
  createdAt DateTime @default(now())
  @@unique([enquiryId, version])
}

model EnquiryActivity {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  actorId String
  actor ShopAdmin @relation("EnquiryActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee ShopAdmin? @relation("EnquiryActivityAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  version Int
  action String
  body String?
  stage String?
  taskId String?
  subject String?
  createdAt DateTime @default(now())
  @@unique([enquiryId, version])
}

// Durable route identity: removing or restoring content never resets first publication.
model ShopArticlePublication {
  blog String
  handle String
  publishedAt DateTime @default(now())
  @@id([blog, handle])
}

model EnquiryDelivery {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  /// "email" (the staff alert) or "keeri" (the lead sent to Keeri).
  target String @default("email")
  configurationHash String
  status String @default("queued")
  version Int @default(0)
  attempts Int @default(0)
  nextAttemptAt DateTime? @default(now())
  firstAttemptAt DateTime?
  acceptedAt DateTime?
  errorCode String?
  providerId String?
  /// Keeri's answer for a "keeri" row once accepted: its lead id, "created" or "matched", and the admin path.
  keeriLeadId String?
  keeriOutcome String?
  keeriLeadPath String?
  leaseToken String?
  leaseExpiresAt DateTime?
  createdAt DateTime @default(now())
  retries EnquiryDeliveryRetryAudit[]
  @@unique([enquiryId, target])
  @@index([target, status, nextAttemptAt])
}

model EnquiryDeliveryRetryAudit {
  id String @id @default(cuid())
  deliveryId String
  delivery EnquiryDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  actorId String
  actor ShopAdmin @relation(fields: [actorId], references: [id], onDelete: Restrict)
  version Int
  createdAt DateTime @default(now())
  @@unique([deliveryId, version])
}

/// The automatic Instagram feed's single state row (id 1): last refresh, error, lease and any refreshed token.
model InstagramFeedState {
  id Int @id @default(1)
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  errorCode String?
  tokenExpiresAt DateTime?
  dataAccessExpiresAt DateTime?
  /// SHA-256 of the env token the stored token was refreshed from; a new env token replaces it.
  tokenSource String?
  /// The refreshed token, AES-256-GCM encrypted with a key derived from the app secret.
  tokenCiphertext String?
  leaseToken String?
  leaseExpiresAt DateTime?
}

/// The last good set of posts from Instagram, with our own copy of each image.
model InstagramFeedPost {
  id String @id
  permalink String
  mediaType String
  caption String
  postedAt DateTime
  imageSha256 String
  image Bytes
  width Int
  height Int
  hidden Boolean @default(false)
  hiddenAt DateTime?
  fetchedAt DateTime
  @@index([postedAt])
  @@index([imageSha256])
}
