generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Product {
  id String @id
  handle String @unique
  title String
  description String
  pdpContent Json?
  category String?
  images String[]
  published Boolean @default(false)
  source String
  sourceStatus String?
  sourceUpdatedAt DateTime
  variants Variant[]
  identities ProductSourceIdentity[]
  updatedAt DateTime @updatedAt
}
model Variant {
  id String @id
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title String
  sku String?
  pricePaise Int?
  compareAtPaise Int?
  published Boolean @default(true)
  available Boolean @default(false)
  stockPolicy String @default("unverified")
  cartItems CartItem[]
  identities VariantSourceIdentity[]
}

model ProductSourceIdentity {
  source String
  externalId String
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([source, externalId])
  @@unique([source, productId])
}

model VariantSourceIdentity {
  source String
  externalId String
  variantId String
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  @@id([source, externalId])
  @@unique([source, variantId])
}
model Cart {
  id String @id @default(cuid())
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items CartItem[]
  revision Int @default(0)
  mutations CartMutationReceipt[]
}
model CartMutationReceipt {
  cartId String
  operationId String
  payloadHash String
  status Int
  code String
  message String
  createdAt DateTime @default(now())
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  @@id([cartId, operationId])
}
model CartItem {
  cartId String
  variantId String
  quantity Int
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@id([cartId, variantId])
}

// One durable cursor per tenant source, including completely empty snapshots.
model CatalogueSyncState {
  source String @id
  capturedAt DateTime
  payloadHash String
  importedAt DateTime @default(now())
}

model Enquiry {
  id String @id
  idempotencyHash String @unique
  payloadHash String
  kind String
  name String
  email String
  phone String
  message String
  context Json
  status String @default("new")
  version Int @default(0)
  reviews EnquiryReviewAudit[]
  assignedToId String?
  assignedTo ShopAdmin? @relation("AssignedEnquiries", fields: [assignedToId], references: [id], onDelete: Restrict)
  activity EnquiryActivity[]
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([assignedToId, createdAt, id])
}

model CheckoutAttempt {
  id String @id
  cartId String
  merchantScope String
  idempotencyKey String
  receipt String @unique
  snapshot Json
  amountPaise Int
  currency String @default("INR")
  state String @default("reservation_required")
  reservationId String? @unique
  reservationExpiresAt DateTime?
  providerOrderId String? @unique
  paymentId String? @unique
  capturedAt DateTime?
  failureCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cartId, idempotencyKey])
}

model PaymentWebhookInbox {
  id String @id @default(cuid())
  merchantScope String
  eventId String
  bodySha256 String
  eventType String
  providerOrderId String?
  paymentId String?
  state String @default("pending")
  failureCode String?
  receivedAt DateTime @default(now())
  processedAt DateTime?
  workerState String @default("pending")
  deliveryAttempts Int @default(0)
  nextAttemptAt DateTime @default(dbgenerated("timezone('UTC'::text, now())"))
  leaseToken String?
  leaseExpiresAt DateTime?
  workerFailureCode String?
  @@unique([merchantScope, eventId])
  @@unique([merchantScope, bodySha256])
  @@index([state, receivedAt])
  @@index([merchantScope, workerState, nextAttemptAt])
}

model OrderOutbox {
  id String @id @default(cuid())
  attemptId String
  kind String
  payload Json
  state String @default("pending")
  deliveryAttempts Int @default(0)
  nextAttemptAt DateTime @default(dbgenerated("timezone('UTC'::text, now())"))
  leaseToken String?
  leaseExpiresAt DateTime?
  failureCode String?
  deliveredAt DateTime?
  externalOrderId String?
  createdAt DateTime @default(now())
  @@unique([attemptId, kind])
  @@index([state, createdAt])
  @@index([state, nextAttemptAt])
}

// Shop presentation authority is separate from Keeri commerce data.
enum ShopAdminRole {
  editor
  publisher
}
model ShopAdmin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role ShopAdminRole
  active Boolean @default(true)
  canManageEnquiries Boolean @default(false)
  failedAttempts Int @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())
  sessions ShopAdminSession[]
  revisions ShopContentRevision[]
  mediaAssets ShopMediaAsset[]
  enquiryReviews EnquiryReviewAudit[]
  assignedEnquiries Enquiry[] @relation("AssignedEnquiries")
  enquiryActivity EnquiryActivity[] @relation("EnquiryActivityActor")
  enquiryAssignments EnquiryActivity[] @relation("EnquiryActivityAssignee")
}
model ShopAdminSession {
  id String @id @default(cuid())
  tokenHash String @unique
  adminId String
  admin ShopAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model ShopContent {
  id String @id
  version Int @default(0)
  draft Json
  published Json?
  publishedVersion Int?
  updatedAt DateTime @updatedAt
  revisions ShopContentRevision[]
}
model ShopContentRevision {
  id String @id @default(cuid())
  documentId String
  document ShopContent @relation(fields: [documentId], references: [id], onDelete: Restrict)
  version Int
  action String
  content Json
  actorId String
  actor ShopAdmin @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  @@unique([documentId, version])
}

model ShopMediaAsset {
  id String @id @default(cuid())
  sha256 String @unique
  storageKey String @unique
  label String
  width Int
  height Int
  bytes Int
  mimeType String
  createdById String
  createdBy ShopAdmin @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  publicAt DateTime?
  @@index([createdAt, id])
}
model EnquiryReviewAudit {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  actorId String
  actor ShopAdmin @relation(fields: [actorId], references: [id], onDelete: Restrict)
  version Int
  action String
  createdAt DateTime @default(now())
  @@unique([enquiryId, version])
}

model EnquiryActivity {
  id String @id @default(cuid())
  enquiryId String
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  actorId String
  actor ShopAdmin @relation("EnquiryActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee ShopAdmin? @relation("EnquiryActivityAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  version Int
  action String
  body String?
  createdAt DateTime @default(now())
  @@unique([enquiryId, version])
}

// Durable route identity: removing or restoring content never resets first publication.
model ShopArticlePublication {
  blog String
  handle String
  publishedAt DateTime @default(now())
  @@id([blog, handle])
}
