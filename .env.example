# Local development only. Use a dedicated database; never point seed/tests at Keeri.
DATABASE_URL=postgresql://shopmaple:shopmaple@127.0.0.1:55439/shopmaple
TEST_DATABASE_URL=postgresql://shopmaple:shopmaple@127.0.0.1:55439/shopmaple_test
API_PORT=4100
API_HOST=127.0.0.1
API_URL=http://127.0.0.1:4100
WEB_ORIGIN=http://localhost:3000
CATALOG_MODE=preview
# Production Tunnel -> local Next -> local API only. Keep false for direct/public API listeners.
API_TRUST_PROXY_LOOPBACK=false
# Enquiry alerts remain disabled until sender/recipient/private credentials are configured.
ENQUIRY_DELIVERY_ENABLED=false
# When explicitly enabled, supply ENQUIRY_RESEND_API_KEY, ENQUIRY_MAIL_FROM and
# ENQUIRY_MAIL_TO privately. Publisher email does not select the alert recipient.
# Live checkout stays off unless CHECKOUT_ENABLED=true and every commerce key is set privately:
# KEERI_ORIGIN, KEERI_COMMERCE_TOKEN, KEERI_TENANT_ID, KEERI_MERCHANT_SCOPE,
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, CHECKOUT_DELIVERY_METHODS.
# See docs/store-deployment.md for the release gate each key belongs to.
CHECKOUT_ENABLED=false
# Optional: signs 15-minute staff draft-preview tokens so they survive API restarts and
# work across several API processes. Leave unset for a per-process random key.
# ADMIN_PREVIEW_SECRET=
# Search engines: every response says noindex unless SEO_INDEXING=on (web and API read it at
# request time, so a restart applies it). SITE_URL is the public address used in canonical
# links, the sitemap and structured data. See docs/seo.md.
SEO_INDEXING=off
SITE_URL=https://store.maplefurnishers.com
# Homepage Instagram feed (docs/instagram-feed.md). Off, showing the staff-edited posts, until all
# four are set privately on the API host. Never commit real values.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# META_APP_ID=
# META_APP_SECRET=
